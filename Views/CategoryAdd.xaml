<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppStockControl.Views.CategoryAdd"
             Title="Category">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto, Auto, Auto">

            <Border StrokeShape="12"
                    HeightRequest="50"
                    WidthRequest="130"
                    HorizontalOptions="Center">
                
                <Label Text="Cadastrar"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontSize="30"/>
            </Border>

            <Grid Grid.Row="1"
                  RowSpacing="10"
                  VerticalOptions="Center"
                  Margin="50"
                  HorizontalOptions="Fill"
                  RowDefinitions="Auto, Auto, Auto, Auto">

                <Entry x:Name="txtNameCategory" 
                       Placeholder="Nome"
                       Grid.Row="0"/>
                
                <Entry x:Name="txtDescriptionCategory" 
                       Placeholder="Descrição"
                       Grid.Row="1"/>

                <RadioButton Content="Ativado"
                             Grid.Row="2"
                             IsChecked="True"
                             HorizontalOptions="Start"
                             x:Name="rbEnable"/>

                <RadioButton Content="Desativado"
                             Grid.Row="2"
                             HorizontalOptions="Center"/>
            </Grid>

            <Button Grid.Row="2"
                    Margin="100"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Text="Salvar"
                    Clicked="Button_Cliked_Save"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>