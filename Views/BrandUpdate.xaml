<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppStockControl.Views.BrandUpdate"
             Title="BrandUpate">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto, Auto, Auto">

            <Border StrokeShape="12"
                     HeightRequest="50"
                     WidthRequest="200"
                     HorizontalOptions="Center">
                <Grid>

                    <Label Text="Atualizar"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            FontSize="30"/>

                    <Button HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ImageSource="voltar.png"
                            Clicked="Button_Clicked_Cancel"
                            BackgroundColor="Transparent"/>

                </Grid>
            </Border>

            <Grid Grid.Row="1"
                    RowSpacing="10"
                    VerticalOptions="Center"
                    Margin="50"
                    HorizontalOptions="Fill"
                    RowDefinitions="Auto, Auto, Auto, Auto">

                <Entry x:Name="txtNameCategory" 
                        Placeholder="Nome"
                        Grid.Row="0"/>

                <Entry x:Name="txtDescriptionCategory" 
                        Placeholder="Descrição"
                        Grid.Row="1"/>

                <RadioButton Content="Ativado"
                              Grid.Row="2"
                              IsChecked="True"
                              HorizontalOptions="Start"
                              x:Name="rbEnable"/>

                <RadioButton Content="Desativado"
                              Grid.Row="2"
                              HorizontalOptions="Center"/>
            </Grid>

            <Button Grid.Row="2"
                     Margin="100"
                     FontAttributes="Bold"
                     HorizontalOptions="Center"
                     Text="Salvar"
                     Clicked="Button_Cliked_Save"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>