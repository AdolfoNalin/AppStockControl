<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppStockControl.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppStockControl"
    xmlns:views="clr-namespace:AppStockControl.Views"
    Title="AppStockControl"
    Shell.NavBarIsVisible="False">

    <TabBar>

        <ShellContent   
            Title="Produto"
            Route="product"
            Icon="compras.png"
            ContentTemplate="{DataTemplate views:ProductList}"/>

        <ShellContent
            Title="Categoria"
            Route="category"
            Icon="categoria.png"
            ContentTemplate="{DataTemplate views:CategoryList}"/>

        <ShellContent
            Title="Menu"
            Route="menu"
            Icon="menu.png"
            ContentTemplate="{DataTemplate views:Menu}"/>

        <ShellContent
            Title="Fornecedor"
            Route="Supplier"
            Icon="fornecedor.png"
            ContentTemplate="{DataTemplate views:Supplier}"/>

        <ShellContent
            Title="Marcas"
            Route="Brand"
            Icon="marca.png"
            ContentTemplate="{DataTemplate views:Brand}"/>
    </TabBar> 

</Shell>
